// ============================================================
// 1. 全局基础样式
// ============================================================

// 全局字体（中英文分开指定）
body {
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.8;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

// 正文区域
.post-body {
  font-size: 16px;
  letter-spacing: 0.3px;
}


// ============================================================
// 2. 滚动条美化
// ============================================================

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #c1c7cd;
  border-radius: 10px;
  transition: background 0.2s;
}

::-webkit-scrollbar-thumb:hover {
  background: #a0a7ae;
}

// 暗色模式滚动条
[data-theme="dark"] ::-webkit-scrollbar-thumb {
  background: #3d444d;
}
[data-theme="dark"] ::-webkit-scrollbar-thumb:hover {
  background: #555d66;
}


// ============================================================
// 3. 导航栏毛玻璃效果
// ============================================================

.header {
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  background: rgba(255, 255, 255, 0.72) !important;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.06);
  transition: background 0.3s ease;
}

[data-theme="dark"] .header {
  background: rgba(20, 20, 30, 0.78) !important;
  box-shadow: 0 1px 8px rgba(0, 0, 0, 0.3);
}


// ============================================================
// 4. 侧边栏
// ============================================================

.sidebar {
  border-radius: 12px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
}

// 侧边栏头像
.site-author-image {
  border-radius: 50% !important;
  box-shadow: 0 0 0 4px #fff, 0 4px 12px rgba(0, 0, 0, 0.12);
  transition: transform 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) !important;
}

.site-author-image:hover {
  transform: rotate(360deg) scale(1.05);
}


// ============================================================
// 5. 文章卡片
// ============================================================

.post-block {
  border-radius: 12px !important;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04) !important;
  transition: transform 0.35s ease, box-shadow 0.35s ease !important;
}

.post-block:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
}


// ============================================================
// 6. 文章标题
// ============================================================

.post-title {
  font-weight: 700 !important;
  color: #667eea;                        // 👈 后备颜色
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

// 文章内部标题
.post-body h2 {
  position: relative;
  padding-bottom: 10px;
  margin-top: 40px !important;
  border-bottom: 2px solid rgba(102, 126, 234, 0.15);
}

.post-body h2::before {
  content: '# ';
  color: #667eea;
  font-weight: 700;
}

.post-body h3::before {
  content: '## ';
  color: #764ba2;
  font-weight: 700;
}

.post-body h2,
.post-body h3,
.post-body h4 {
  margin-top: 30px !important;
}


// ============================================================
// 7. 代码块（核心！）
// ============================================================

// 强制所有代码块使用 Fira Code
code,
kbd,
pre,
.highlight,
.codeblock,
figure.highlight,
code[class*="language-"],
pre[class*="language-"] {
  font-family: 'Fira Code', 'Consolas', 'Monaco', monospace !important;
}

// 行内代码
.post-body code:not([class*="language-"]) {
  font-family: 'Fira Code', 'Consolas', monospace !important;
  background: rgba(102, 126, 234, 0.08) !important;
  padding: 2px 8px !important;
  border-radius: 4px !important;
  font-size: 0.9em !important;
  color: #667eea !important;
}

[data-theme="dark"] .post-body code:not([class*="language-"]) {
  background: rgba(102, 126, 234, 0.15) !important;
  color: #8b9cf7 !important;
}

// 代码块整体
.highlight {
  border-radius: 10px !important;
  margin: 20px 0 !important;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05) !important;
  transition: box-shadow 0.3s ease;
}

.highlight:hover {
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.10) !important;
}

// 代码块行号
.highlight .line-numbers-rows {
  border-right: 1px solid rgba(0, 0, 0, 0.06) !important;
  padding-right: 8px !important;
}

[data-theme="dark"] .highlight .line-numbers-rows {
  border-right-color: rgba(255, 255, 255, 0.06) !important;
}

// 复制按钮（悬停显示）
.highlight .copy-btn {
  opacity: 0;
  transition: opacity 0.3s ease;
  background: rgba(0, 0, 0, 0.6) !important;
  color: #fff !important;
  border-radius: 6px !important;
  padding: 4px 12px !important;
  font-size: 12px !important;
}

.highlight:hover .copy-btn {
  opacity: 1;
}


// ============================================================
// 8. 文章内链接
// ============================================================

.post-body a {
  color: #667eea !important;
  text-decoration: none !important;
  position: relative;
  background-image: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  background-size: 0% 2px;
  background-repeat: no-repeat;
  background-position: 0 bottom;
  transition: background-size 0.3s ease;
}

.post-body a:hover {
  background-size: 100% 2px;
}

[data-theme="dark"] .post-body a {
  color: #8b9cf7 !important;
}


// ============================================================
// 9. 引用块
// ============================================================

.post-body blockquote {
  border-left: 4px solid #667eea !important;
  background: rgba(102, 126, 234, 0.04) !important;
  padding: 16px 24px !important;
  border-radius: 0 8px 8px 0 !important;
  margin: 20px 0 !important;
}

[data-theme="dark"] .post-body blockquote {
  background: rgba(102, 126, 234, 0.06) !important;
}


// ============================================================
// 10. 目录 (TOC)
// ============================================================

.post-toc .nav .nav-child {
  border-left: 2px solid rgba(102, 126, 234, 0.2);
  padding-left: 16px;
  margin-left: 8px;
}

.post-toc .nav .active > a {
  color: #667eea !important;
  font-weight: 600;
}

.post-toc .nav a {
  transition: all 0.25s ease;
  padding: 3px 0;
  display: inline-block;
}

.post-toc .nav a:hover {
  color: #667eea !important;
  transform: translateX(4px);
}


// ============================================================
// 11. Back2Top 按钮
// ============================================================

.back-to-top {
  border-radius: 50% !important;
  width: 44px !important;
  height: 44px !important;
  background: rgba(102, 126, 234, 0.9) !important;
  color: #fff !important;
  box-shadow: 0 4px 16px rgba(102, 126, 234, 0.25) !important;
  transition: all 0.3s ease !important;
}

.back-to-top:hover {
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 6px 24px rgba(102, 126, 234, 0.35) !important;
}


// ============================================================
// 12. 阅读进度条
// ============================================================

.reading-progress-bar {
  height: 3px !important;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%) !important;
}


// ============================================================
// 13. 页脚
// ============================================================

.footer {
  margin-top: 40px !important;
  padding: 20px 0 !important;
  border-top: 1px solid rgba(0, 0, 0, 0.04);
}

[data-theme="dark"] .footer {
  border-top-color: rgba(255, 255, 255, 0.04);
}


// ============================================================
// 14. 标签 / 分类页面
// ============================================================

// 标签云
.tag-cloud a {
  display: inline-block;
  transition: all 0.25s ease;
  padding: 4px 8px !important;
  border-radius: 4px;
}

.tag-cloud a:hover {
  color: #667eea !important;
  transform: scale(1.05) translateY(-2px);
}

// 分类列表
.category-list a:hover {
  color: #667eea !important;
}


// ============================================================
// 15. 响应式微调
// ============================================================

@media (max-width: 767px) {
  .post-body {
    font-size: 15px;
    letter-spacing: 0.2px;
  }

  .post-block {
    padding: 16px !important;
  }

  .highlight {
    font-size: 13px !important;
  }
}


// ============================================================
// 16. 全局过渡动画（加分项）
// ============================================================

* {
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}
